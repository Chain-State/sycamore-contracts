Cabal-Version:      2.4
Name:               sycamore-validators 
Version:            1.0.0.0
Author:             Kelly Muhindi 
Maintainer:          kmuhindi@proton.me
Build-Type:          Simple
Copyright:           © 2023 Africa Blockchain Center
License:             Apache-2.0
License-files:       LICENSE

library
  hs-source-dirs:      src
  exposed-modules:    
                       Sycamore.Asset.AssetPurchase
                     , Sycamore.Asset.DeployAssetPurchase
                     , Sycamore.Nft.OnChain
  build-depends:       aeson
                     , base ^>=4.14.1.0
                     , bytestring
                     , cardano-api    >=1.35
                     , cardano-crypto-class
                     , cardano-ledger-core
                     , cardano-ledger-shelley
                     , cardano-wallet-core
                     , containers
                     , data-default
                     , freer-extras
                     , openapi3
                     , plutus-contract
                     , plutus-ledger    
                     , plutus-ledger-api    >=1.0.0
                     , plutus-ledger-constraints
                     , plutus-pab
                     , plutus-tx-plugin     >=1.0.0
                     , plutus-tx    >=1.0.0
                     , plutus-script-utils
                     , prettyprinter
                     , serialise
                     , text 
  default-language:    Haskell2010
  ghc-options:         -Wall -fobject-code -fno-ignore-interface-pragmas -fno-omit-interface-pragmas -fno-strictness -fno-spec-constr -fno-specialise


executable token-policy
  main-is: TokenPolicy.hs
  hs-source-dirs:      app
  ghc-options:         -Wall
  build-depends:       base ^>= 4.14.1.0
                     , sycamore-validators


executable token-name-hex 
  main-is: TokenNameHex.hs
  hs-source-dirs:      app
  ghc-options:         -Wall
  build-depends:       base ^>= 4.14.1.0
                     , sycamore-validators


build-tool-depends:
  , cardano-node:cardano-node   >=1.35
  , cardano-submit-api:cardano-submit-api:    >=1.35